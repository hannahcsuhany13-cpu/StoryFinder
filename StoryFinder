/* DISPLAY RECOMMENDATIONS */

function displayRecommendations(type,page) {
    let genres = getGenres();
    let recommendations;
    let results;

    if (type === "books") {
        recommendations = bookRecommendations;
        results = document.getElementById("bookResults");
    } else if (type === "movies") {
        recommendations = movieRecommendations;
        results = document.getElementById("movieResults");
    } else {
        recommendations = tvRecommendations;
        results = document.getElementById("tvResults");
    }

    results.innerHTML = "";

    if (!genres || genres.length === 0) {
        results.textContent =
            "Please complete your personality profile first to get recommendations.";
        return;
    }

    let heading = document.createElement("h2");
    heading.textContent = "Suggestions for " + selectedProfile;
    results.appendChild(heading);

    let found = false;

    genres.forEach(function(genre) {
        let items = recommendations[genre];

        if (!items) return;

        found = true;

        let genreHeading = document.createElement("h2");
        genreHeading.textContent = genre;
        results.appendChild(genreHeading);

        let start = (page * 2) % items.length;

        for (let i=0; i<Math.min(2,items.length); i++) {
            let item = items[(start+i)%items.length];

            let card = document.createElement("div");
            card.className = "book";

            let title = document.createElement("h3");
            title.textContent = item[0];

            let description = document.createElement("p");
            description.textContent = item[1];

            card.appendChild(title);
            card.appendChild(description);
            results.appendChild(card);
        }
    });

    if (!found) {
        results.textContent = "We don't have recommendations for those genres yet.";
    }
}

