/* PROFILE STORAGE */

function getProfiles() {
    return JSON.parse(localStorage.getItem("profiles")) || [];
}

function getProfilePictures() {
    return JSON.parse(localStorage.getItem("profilePictures")) || {};
}

function getProfilePicture(name) {
    let pictures = getProfilePictures();

    return pictures[name] || {
        type:"preset",
        emoji:"📚",
        background:"#E5EDE3"
    };
}

/* SAVE PROFILE - DUPLICATE NAME CHECK */

function saveProfile() {
    let name = document.getElementById("nameInput").value.trim();
    let message = document.getElementById("nameMessage");

    if (name === "") {
        message.textContent = "Please enter a profile name.";
        return;
    }

    let profiles = getProfiles();

    let duplicate = profiles.some(function(existingName) {
        return existingName.toLowerCase() === name.toLowerCase();
    });

    if (duplicate) {
        message.textContent = "That profile name is already taken. Please choose another name.";
        alert("A profile with that name already exists!");
        return;
    }

    profiles.push(name);

    let pictures = getProfilePictures();
    pictures[name] = selectedAvatar;

    try {
        localStorage.setItem("profilePictures",JSON.stringify(pictures));
        localStorage.setItem("profiles",JSON.stringify(profiles));
    } catch(error) {
        alert("There isn't enough browser storage to save that picture. Try a smaller image.");
        return;
    }

    message.textContent = "";
    document.getElementById("nameInput").value = "";
    document.getElementById("profileUpload").value = "";

    showSavedProfiles();
    alert("Profile created successfully!");
}

/* DISPLAY SAVED PROFILES */

function showSavedProfiles() {
    let profiles = getProfiles();
    let display = document.getElementById("savedProfiles");

    display.innerHTML = "";

    if (profiles.length === 0) {
        display.textContent = "No profiles have been created yet.";
        return;
    }

    profiles.forEach(function(name) {
        let card = document.createElement("div");
        card.className = "profile-card";

        let row = document.createElement("div");
        row.className = "profile-row";

        row.appendChild(createProfileAvatar(getProfilePicture(name)));

        let selectButton = document.createElement("button");
        selectButton.textContent = name;
        selectButton.onclick = function() {
            selectProfile(name);
        };

        let deleteButton = document.createElement("button");
        deleteButton.textContent = "Delete";
        deleteButton.className = "soft-button";

        deleteButton.onclick = function() {
            if (!confirm("Delete the profile for " + name + "?")) return;

            let updatedProfiles = getProfiles().filter(function(profileName) {
                return profileName !== name;
            });

            localStorage.setItem("profiles",JSON.stringify(updatedProfiles));

            let pictures = getProfilePictures();
            delete pictures[name];
            localStorage.setItem("profilePictures",JSON.stringify(pictures));

            let allAnswers = JSON.parse(localStorage.getItem("personalityAnswers")) || {};
            delete allAnswers[name];
            localStorage.setItem("personalityAnswers",JSON.stringify(allAnswers));

            let allExtra = JSON.parse(localStorage.getItem("extraAnswers")) || {};
            delete allExtra[name];
            localStorage.setItem("extraAnswers",JSON.stringify(allExtra));

            showSavedProfiles();
        };

        row.appendChild(selectButton);
        row.appendChild(deleteButton);

        card.appendChild(row);
        display.appendChild(card);
    });
}

