
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#829B83">
<title>StoryFinder</title>

<style>
:root {
    --sage: #829B83;
    --sage-dark: #526D55;
    --sage-light: #E5EDE3;
    --background: #F3F6F0;
    --white: #FFFFFF;
    --dark: #344638;
    --muted: #718074;
    --border: #CCD8CA;
    --shadow: 0 4px 15px rgba(55, 80, 58, .10);
}

* { box-sizing: border-box; }

body {
    margin: 0;
    padding: 0 0 90px;
    font-family: Arial, sans-serif;
    color: var(--dark);
    background: var(--background);
    text-align: center;
}

h1, h2, h3 { color: var(--sage-dark); }

h1 { font-size: 28px; }
h2 { font-size: 22px; }
h3 { font-size: 18px; }

p { line-height: 1.5; }

.app-header {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 17px;
    background: var(--sage-dark);
    color: white;
    font-size: 23px;
    font-weight: bold;
    text-align: left;
    box-shadow: var(--shadow);
}

.screen {
    display: none;
    width: calc(100% - 24px);
    max-width: 850px;
    min-height: 350px;
    margin: 20px auto;
    padding: 28px 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--white);
    box-shadow: var(--shadow);
}

#welcomeScreen { display: block; }

button {
    margin: 6px;
    padding: 13px 19px;
    border: 1px solid var(--sage-dark);
    border-radius: 9px;
    background: var(--sage);
    color: white;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: var(--sage-dark);
}

button:disabled {
    opacity: .5;
    cursor: not-allowed;
}

.main-button {
    width: 90%;
    max-width: 390px;
    padding: 15px;
    background: var(--sage-dark);
}

.soft-button {
    background: var(--sage-light);
    color: var(--sage-dark);
    border-color: var(--border);
}

.soft-button:hover {
    background: #D4E1D2;
    color: var(--dark);
}

input {
    max-width: 90%;
    margin: 8px;
    padding: 13px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: white;
    font-size: 16px;
}

input:focus {
    outline: 2px solid var(--sage);
}

.mini-photo {
    display: block;
    width: 100%;
    max-width: 540px;
    height: 150px;
    margin: 16px auto;
    border-radius: 12px;
    object-fit: cover;
}

.small-text {
    color: var(--muted);
    font-size: 13px;
}

.tagline {
    color: var(--muted);
    max-width: 450px;
    margin: 0 auto 20px;
}

.divider {
    width: 80%;
    height: 1px;
    margin: 25px auto;
    background: var(--border);
}

/* PROFILE PICTURES */

.avatar-preview {
    display: flex;
    width: 120px;
    height: 120px;
    margin: 16px auto;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 4px solid var(--sage);
    border-radius: 50%;
    background: var(--sage-light);
    font-size: 48px;
}

.avatar-preview img,
.profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.avatar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    max-width: 360px;
    margin: 15px auto;
}

.avatar-choice {
    display: flex;
    aspect-ratio: 1;
    margin: 0;
    padding: 5px;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--sage-light);
    font-size: 30px;
}

.avatar-choice.selected-avatar {
    border: 3px solid var(--sage-dark);
    background: #D1E0CE;
}

.profile-avatar {
    display: inline-flex;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2px solid var(--sage);
    border-radius: 50%;
    background: var(--sage-light);
    font-size: 25px;
}

.profile-card {
    max-width: 450px;
    margin: 12px auto;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #F8FAF6;
}

.profile-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.upload-label {
    display: inline-block;
    margin: 10px;
    padding: 12px 17px;
    border-radius: 8px;
    background: var(--sage);
    color: white;
    font-weight: bold;
    cursor: pointer;
}

.upload-input { display: none; }

/* CAMERA */

.camera-area {
    max-width: 450px;
    margin: 15px auto;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--background);
}

.camera-area video {
    display: none;
    width: 100%;
    max-height: 320px;
    border-radius: 8px;
    background: #222;
    object-fit: cover;
}

.camera-message {
    color: var(--muted);
    font-size: 13px;
}

/* RECOMMENDATIONS */

.book {
    max-width: 480px;
    margin: 14px auto;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #F8FAF6;
    text-align: left;
}

.book h3 { margin-bottom: 5px; }
.book p { color: var(--muted); }

/* QUESTIONS */

.choice {
    display: block;
    width: 90%;
    max-width: 440px;
    margin: 9px auto;
    border: 1px solid var(--border);
    background: var(--sage-light);
    color: var(--dark);
}

.choice.selected {
    border: 2px solid var(--sage-dark);
    background: #C8DAC6;
}

/* BOTTOM NAVIGATION */

#appNav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: 20;
    width: 100%;
    padding: 9px 4px;
    justify-content: space-around;
    border-top: 1px solid var(--border);
    background: white;
    box-shadow: 0 -3px 12px rgba(0,0,0,.08);
}

.nav-button {
    min-width: 55px;
    margin: 0;
    padding: 8px 6px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    box-shadow: none;
}

.nav-button:hover,
.nav-button.active {
    background: var(--sage-light);
    color: var(--sage-dark);
}

.nav-icon {
    display: block;
    margin-bottom: 3px;
    font-size: 21px;
}

@media(max-width: 600px) {
    .screen {
        margin: 12px auto;
        padding: 22px 14px;
    }

    h1 { font-size: 24px; }

    .nav-button {
        min-width: 52px;
        font-size: 11px;
    }

    .avatar-grid { max-width: 310px; }
}
</style>
</head>

<body>

<div class="app-header">StoryFinder</div>

<!-- WELCOME SCREEN -->

<div id="welcomeScreen" class="screen">
    <h1>Welcome to StoryFinder</h1>
    <p class="tagline">Find your next favourite book, movie or TV show.</p>

    <img class="mini-photo"
    src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=1000&q=80"
    alt="Bookshelf">

    <button class="main-button" onclick="showProfile()">Get Started</button>
</div>

<!-- PROFILE SCREEN -->

<div id="profile" class="screen">
    <h1>Your Profiles</h1>
    <p>Create a profile or choose one you already have.</p>

    <h2>Create a Profile</h2>
    <input id="nameInput" placeholder="Enter your name">

    <p id="nameMessage" class="small-text"></p>

    <h3>Choose a Profile Picture</h3>
    <div id="profilePicturePreview" class="avatar-preview">📚</div>
    <div id="profileAvatarChoices" class="avatar-grid"></div>

    <h3>Take or Upload a Picture</h3>

    <div class="camera-area">
        <video id="profileVideo" autoplay playsinline></video>
        <p id="profileCameraMessage" class="camera-message">
            You can use your camera to take a profile picture.
        </p>
        <button class="soft-button" onclick="startCamera('profile')">
            Open Camera
        </button>
        <button onclick="capturePhoto('profile')" id="profileCaptureButton" disabled>
            Take Picture
        </button>
        <button class="soft-button" onclick="stopCamera('profile')" id="profileStopButton" disabled>
            Close Camera
        </button>
    </div>

    <label class="upload-label" for="profileUpload">Upload a Picture</label>
    <input class="upload-input" type="file" id="profileUpload" accept="image/*">

    <br>
    <button class="main-button" onclick="saveProfile()">Save Profile</button>

    <div class="divider"></div>

    <h2>Saved Profiles</h2>
    <div id="savedProfiles"></div>

    <button class="soft-button" onclick="showWelcome()">Back</button>
</div>

<!-- EDIT PICTURE SCREEN -->

<div id="pictureScreen" class="screen">
    <h1>Change Profile Picture</h1>
    <p id="pictureScreenName"></p>

    <div id="editPicturePreview" class="avatar-preview">📚</div>

    <h3>Choose a Picture</h3>
    <div id="editAvatarChoices" class="avatar-grid"></div>

    <div class="camera-area">
        <video id="editVideo" autoplay playsinline></video>
        <p id="editCameraMessage" class="camera-message">
            Take a new picture using your camera.
        </p>
        <button class="soft-button" onclick="startCamera('edit')">
            Open Camera
        </button>
        <button onclick="capturePhoto('edit')" id="editCaptureButton" disabled>
            Take Picture
        </button>
        <button class="soft-button" onclick="stopCamera('edit')" id="editStopButton" disabled>
            Close Camera
        </button>
    </div>

    <label class="upload-label" for="editPictureUpload">Upload a Picture</label>
    <input class="upload-input" type="file" id="editPictureUpload" accept="image/*">

    <br>
    <button class="main-button" onclick="savePictureChange()">Save Picture</button>
    <button class="soft-button" onclick="goHome()">Cancel</button>
</div>

<!-- HOME SCREEN -->

<div id="homeScreen" class="screen">
    <div id="homeAvatar" class="avatar-preview">📚</div>
    <h1 id="welcomeName"></h1>

    <p class="tagline">What would you like to discover today?</p>

    <button class="soft-button" onclick="editProfilePicture()">
        Change Profile Picture
    </button>

    <img class="mini-photo"
    src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=1000&q=80"
    alt="Books">

    <h2>Build Your Personality Profile</h2>
    <p>Answer a few questions so we can find recommendations for you.</p>

    <button class="main-button" onclick="startQuestionnaire()">
        Build My Personality Profile
    </button>

    <br>
    <button class="soft-button" onclick="startExtraQuestions()">
        Answer More Questions (Optional)
    </button>

    <div class="divider"></div>

    <h2>Explore</h2>

    <button class="main-button" onclick="findBooks()">Find a Book</button>
    <br>
    <button class="main-button" onclick="findMovies()">Find a Movie</button>
    <br>
    <button class="main-button" onclick="findTVShows()">Find a TV Show</button>

    <div class="divider"></div>
    <button class="soft-button" onclick="showProfile()">Switch Profile</button>
</div>

<!-- QUESTIONNAIRE -->

<div id="questionnaire" class="screen">
    <h1 id="surveyTitle">Let's Get to Know You</h1>
    <h2 id="questionText"></h2>
    <p id="questionHint"></p>

    <div id="answerArea"></div>

    <button class="main-button" onclick="nextQuestion()">Next</button>
    <button class="soft-button" onclick="goHome()">Cancel</button>
</div>

<!-- BOOKS -->

<div id="bookScreen" class="screen">
    <h1>Book Recommendations</h1>
    <img class="mini-photo"
    src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=1000&q=80"
    alt="Reading">

    <div id="bookResults"></div>

    <button class="main-button" onclick="showMoreBooks()">Show Me More</button>
    <button class="soft-button" onclick="startExtraQuestions()">Improve Recommendations</button>
    <button class="soft-button" onclick="goHome()">Back to Home</button>
</div>

<!-- MOVIES -->

<div id="movieScreen" class="screen">
    <h1>Movie Recommendations</h1>
    <img class="mini-photo"
    src="https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1000&q=80"
    alt="Movie theatre">

    <div id="movieResults"></div>

    <button class="main-button" onclick="showMoreMovies()">Show Me More</button>
    <button class="soft-button" onclick="startExtraQuestions()">Improve Recommendations</button>
    <button class="soft-button" onclick="goHome()">Back to Home</button>
</div>

<!-- TV SHOWS -->

<div id="tvScreen" class="screen">
    <h1>TV Show Recommendations</h1>
    <img class="mini-photo"
    src="https://images.unsplash.com/photo-1522869635100-9f4c5e86aa37?auto=format&fit=crop&w=1000&q=80"
    alt="Television">

    <div id="tvResults"></div>

    <button class="main-button" onclick="showMoreTVShows()">Show Me More</button>
    <button class="soft-button" onclick="startExtraQuestions()">Improve Recommendations</button>
    <button class="soft-button" onclick="goHome()">Back to Home</button>
</div>

<!-- BOTTOM NAVIGATION -->

<div id="appNav">
    <button class="nav-button active" id="navHome" onclick="goHome()">
        <span class="nav-icon">⌂</span>Home
    </button>
    <button class="nav-button" id="navBooks" onclick="findBooks()">
        <span class="nav-icon">📚</span>Books
    </button>
    <button class="nav-button" id="navMovies" onclick="findMovies()">
        <span class="nav-icon">🎬</span>Movies
    </button>
    <button class="nav-button" id="navTV" onclick="findTVShows()">
        <span class="nav-icon">▣</span>Shows
    </button>
    <button class="nav-button" id="navProfile" onclick="showProfile()">
        <span class="nav-icon">●</span>Profiles
    </button>
</div>

<script>

/* VARIABLES */

let selectedProfile = "";
let currentQuestion = 0;
let answers = [];
let activeQuestions = [];
let activeMode = "basic";

let selectedAvatar = {
    type: "preset",
    emoji: "📚",
    background: "#E5EDE3"
};

let editingAvatar = null;

let cameraStreams = {
    profile: null,
    edit: null
};

let recommendationPages = {
    books: 0,
    movies: 0,
    tv: 0
};

/* AVATAR OPTIONS */

let avatarOptions = [
    {emoji:"📚",background:"#E5EDE3"},
    {emoji:"🌿",background:"#DCE8D9"},
    {emoji:"🌻",background:"#EAEBD7"},
    {emoji:"🪴",background:"#D7E5D5"},
    {emoji:"🐈",background:"#E8E8E0"},
    {emoji:"🌙",background:"#DFE5E9"},
    {emoji:"🌷",background:"#E8E0E7"},
    {emoji:"🦋",background:"#DCE7E8"},
    {emoji:"🍃",background:"#DCE9D9"},
    {emoji:"⭐",background:"#EAEBD7"},
    {emoji:"🎧",background:"#E1E6E0"},
    {emoji:"🌼",background:"#EAE9D7"}
];

/* SCREEN NAVIGATION */

function hideAllScreens() {
    let screens = [
        "welcomeScreen","profile","pictureScreen",
        "homeScreen","questionnaire","bookScreen",
        "movieScreen","tvScreen"
    ];

    screens.forEach(function(id) {
        document.getElementById(id).style.display = "none";
    });
}

function scrollToTop() {
    window.scrollTo(0,0);
}

function setNavActive(activeId) {
    let ids = ["navHome","navBooks","navMovies","navTV","navProfile"];

    ids.forEach(function(id) {
        document.getElementById(id).classList.remove("active");
    });

    if (activeId) {
        document.getElementById(activeId).classList.add("active");
    }
}

function showWelcome() {
    stopCamera("profile");
    hideAllScreens();
    document.getElementById("appNav").style.display = "none";
    document.getElementById("welcomeScreen").style.display = "block";
    scrollToTop();
}

function showProfile() {
    stopCamera("profile");
    stopCamera("edit");

    hideAllScreens();
    document.getElementById("appNav").style.display = "none";
    document.getElementById("profile").style.display = "block";

    selectedAvatar = {
        type:"preset",
        emoji:"📚",
        background:"#E5EDE3"
    };

    document.getElementById("nameInput").value = "";
    document.getElementById("nameMessage").textContent = "";
    document.getElementById("profileUpload").value = "";

    renderAvatarChoices("profileAvatarChoices","profilePicturePreview");
    showSavedProfiles();
    scrollToTop();
}

/* AVATAR DISPLAY */

function renderAvatarChoices(containerId,previewId) {
    let container = document.getElementById(containerId);
    container.innerHTML = "";

    let current = containerId === "editAvatarChoices"
        ? editingAvatar : selectedAvatar;

    avatarOptions.forEach(function(option) {
        let button = document.createElement("button");
        button.className = "avatar-choice";
        button.textContent = option.emoji;
        button.style.backgroundColor = option.background;

        if (current && current.type === "preset" &&
            current.emoji === option.emoji) {
            button.classList.add("selected-avatar");
        }

        button.onclick = function() {
            let newAvatar = {
                type:"preset",
                emoji:option.emoji,
                background:option.background
            };

            if (containerId === "editAvatarChoices") {
                editingAvatar = newAvatar;
            } else {
                selectedAvatar = newAvatar;
            }

            renderAvatarChoices(containerId,previewId);
        };

        container.appendChild(button);
    });

    showAvatarInElement(previewId,current);
}

function showAvatarInElement(elementId,avatar) {
    let element = document.getElementById(elementId);
    element.innerHTML = "";

    if (!avatar) {
        avatar = {
            type:"preset",
            emoji:"📚",
            background:"#E5EDE3"
        };
    }

    if (avatar.type === "image") {
        let image = document.createElement("img");
        image.src = avatar.src;
        image.alt = "Profile picture";
        element.appendChild(image);
    } else {
        element.textContent = avatar.emoji;
        element.style.backgroundColor = avatar.background;
    }
}

function createProfileAvatar(avatar) {
    let element = document.createElement("div");
    element.className = "profile-avatar";

    if (avatar.type === "image") {
        let image = document.createElement("img");
        image.src = avatar.src;
        image.alt = "Profile picture";
        element.appendChild(image);
    } else {
        element.textContent = avatar.emoji;
        element.style.backgroundColor = avatar.background;
    }

    return element;
}

/* CAMERA FUNCTIONS */

async function startCamera(which) {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert("Camera access is not supported here. Try opening StoryFinder in Chrome using your HTTPS website address.");
        return;
    }

    stopCamera(which);

    let videoId = which === "profile" ? "profileVideo" : "editVideo";
    let messageId = which === "profile" ? "profileCameraMessage" : "editCameraMessage";
    let captureId = which === "profile" ? "profileCaptureButton" : "editCaptureButton";
    let stopId = which === "profile" ? "profileStopButton" : "editStopButton";

    try {
        let stream = await navigator.mediaDevices.getUserMedia({
            video: {
                facingMode: "user"
            },
            audio: false
        });

        cameraStreams[which] = stream;

        let video = document.getElementById(videoId);
        video.srcObject = stream;
        video.style.display = "block";

        document.getElementById(messageId).textContent =
            "Camera is on. Position yourself and take a picture.";

        document.getElementById(captureId).disabled = false;
        document.getElementById(stopId).disabled = false;

    } catch(error) {
        console.error(error);

        if (error.name === "NotAllowedError") {
            alert("Camera permission was denied. Please allow camera access in your browser settings and try again.");
        } else if (error.name === "NotFoundError") {
            alert("No camera was found on this device.");
        } else {
            alert("The camera could not be opened. Please check your camera permissions.");
        }
    }
}

function capturePhoto(which) {
    let videoId = which === "profile" ? "profileVideo" : "editVideo";
    let video = document.getElementById(videoId);

    if (!cameraStreams[which] || !video.videoWidth) {
        alert("Please open the camera first.");
        return;
    }

    let canvas = document.createElement("canvas");
    let maxSize = 500;

    let scale = Math.min(
        maxSize / video.videoWidth,
        maxSize / video.videoHeight,
        1
    );

    canvas.width = video.videoWidth * scale;
    canvas.height = video.videoHeight * scale;

    let context = canvas.getContext("2d");

    context.drawImage(
        video,
        0,
        0,
        canvas.width,
        canvas.height
    );

    let pictureData = canvas.toDataURL("image/jpeg",0.75);

    let newAvatar = {
        type:"image",
        src:pictureData
    };

    if (which === "profile") {
        selectedAvatar = newAvatar;
        showAvatarInElement("profilePicturePreview",selectedAvatar);
    } else {
        editingAvatar = newAvatar;
        showAvatarInElement("editPicturePreview",editingAvatar);
    }

    stopCamera(which);

    alert("Picture taken! Remember to save your profile picture.");
}

function stopCamera(which) {
    let stream = cameraStreams[which];

    if (stream) {
        stream.getTracks().forEach(function(track) {
            track.stop();
        });
    }

    cameraStreams[which] = null;

    let videoId = which === "profile" ? "profileVideo" : "editVideo";
    let messageId = which === "profile" ? "profileCameraMessage" : "editCameraMessage";
    let captureId = which === "profile" ? "profileCaptureButton" : "editCaptureButton";
    let stopId = which === "profile" ? "profileStopButton" : "editStopButton";

    let video = document.getElementById(videoId);
    video.srcObject = null;
    video.style.display = "none";

    document.getElementById(captureId).disabled = true;
    document.getElementById(stopId).disabled = true;

    document.getElementById(messageId).textContent =
        "Camera is closed.";
}

/* UPLOAD PICTURES */

function uploadPicture(fileInputId,isEditing) {
    let file = document.getElementById(fileInputId).files[0];

    if (!file) return;

    if (!file.type.startsWith("image/")) {
        alert("Please choose an image file.");
        return;
    }

    let reader = new FileReader();

    reader.onload = function(event) {
        let image = new Image();

        image.onload = function() {
            let canvas = document.createElement("canvas");
            let maxSize = 500;

            let scale = Math.min(
                maxSize / image.width,
                maxSize / image.height,
                1
            );

            canvas.width = image.width * scale;
            canvas.height = image.height * scale;

            let context = canvas.getContext("2d");
            context.drawImage(image,0,0,canvas.width,canvas.height);

            let newAvatar = {
                type:"image",
                src:canvas.toDataURL("image/jpeg",0.75)
            };

            if (isEditing) {
                editingAvatar = newAvatar;
                showAvatarInElement("editPicturePreview",editingAvatar);
            } else {
                selectedAvatar = newAvatar;
                showAvatarInElement("profilePicturePreview",selectedAvatar);
            }
        };

        image.src = event.target.result;
    };

    reader.readAsDataURL(file);
}

document.getElementById("profileUpload").addEventListener("change",function() {
