function showQuestion() {
    let question = activeQuestions[currentQuestion];

    document.getElementById("questionText").textContent = question.question;
    document.getElementById("questionHint").textContent =
        question.multiple ? "Choose as many as you like." : "Choose one answer.";

    let area = document.getElementById("answerArea");
    area.innerHTML = "";

    if (question.multiple && !Array.isArray(answers[currentQuestion])) {
        answers[currentQuestion] = [];
    }

    question.choices.forEach(function(choice) {
        let button = document.createElement("button");
        button.className = "choice";
        button.textContent = choice;

        button.onclick = function() {
            if (question.multiple) {
                let selected = answers[currentQuestion];
                let index = selected.indexOf(choice);

                if (index === -1) {
                    selected.push(choice);
                    button.classList.add("selected");
                } else {
                    selected.splice(index,1);
                    button.classList.remove("selected");
                }

                if (choice === "Other") {
                    showOtherInput(selected.includes("Other"));
                }
            } else {
                answers[currentQuestion] = choice;

                area.querySelectorAll("button").forEach(function(other) {
                    other.classList.remove("selected");
                });

                button.classList.add("selected");

                if (["Other","Other sports","Other games"].includes(choice)) {
                    showOtherInput(true);
                } else {
                    showOtherInput(false);
                }
            }
        };

        let selected = answers[currentQuestion];

        if (question.multiple && selected.includes(choice)) {
            button.classList.add("selected");
        }

        if (!question.multiple && selected === choice) {
            button.classList.add("selected");
        }

        area.appendChild(button);
    });

    if (question.multiple && answers[currentQuestion].includes("Other")) {
        showOtherInput(true);
    }

    if (!question.multiple &&
        ["Other","Other sports","Other games"].includes(answers[currentQuestion])) {
        showOtherInput(true);
    }
}

function showOtherInput(show) {
    let oldInput = document.getElementById("otherInput");
    let oldValue = oldInput ? oldInput.value : "";

    if (oldInput) oldInput.remove();

    if (show) {
        let input = document.createElement("input");
        input.id = "otherInput";
        input.placeholder = "Type your answer...";
        input.value = oldValue;
        document.getElementById("answerArea").appendChild(input);
    }
}

function nextQuestion() {
    let question = activeQuestions[currentQuestion];

    if (question.multiple) {
        let selected = answers[currentQuestion];

        if (!selected || selected.length === 0) {
            alert("Please choose at least one answer.");
            return;
        }

        if (selected.includes("Other")) {
            let input = document.getElementById("otherInput");

            if (!input || !input.value.trim()) {
                alert("Please type your other answer.");
                return;
            }

            answers[currentQuestion] = selected.filter(function(item) {
                return item !== "Other";
            });

            answers[currentQuestion].push(input.value.trim());
        }
    } else {
        let answer = answers[currentQuestion];

        if (!answer) {
            alert("Please choose an answer.");
            return;
        }

        if (["Other","Other sports","Other games"].includes(answer)) {
            let input = document.getElementById("otherInput");

            if (!input || !input.value.trim()) {
                alert("Please type your other answer.");
                return;
            }

            answers[currentQuestion] = input.value.trim();
        }
    }

    currentQuestion++;

    if (currentQuestion < activeQuestions.length) {
        showQuestion();
        scrollToTop();
    } else {
        if (activeMode === "basic") {
            let saved = JSON.parse(localStorage.getItem("personalityAnswers")) || {};
            saved[selectedProfile] = answers;
            localStorage.setItem("personalityAnswers",JSON.stringify(saved));
            alert("Your personality profile has been saved!");
        } else {
            let saved = JSON.parse(localStorage.getItem("extraAnswers")) || {};
            saved[selectedProfile] = answers;
            localStorage.setItem("extraAnswers",JSON.stringify(saved));
            alert("Your extra answers have been saved!");
        }

        goHome();
    }
}

